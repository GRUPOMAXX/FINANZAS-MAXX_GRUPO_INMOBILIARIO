Private Function BuscarFilaEntreSecciones( _
    ByVal ws As Worksheet, _
    ByVal columna As Long, _
    ByVal seccionInicial As String, _
    ByVal seccionFinal As String, _
    ByVal textoBuscado As String) As Long

    Dim filaInicio As Long
    Dim filaFin As Long

    filaInicio = BuscarFilaTextoExacto( _
                    ws, _
                    columna, _
                    seccionInicial)

    If filaInicio = 0 Then Exit Function

    filaFin = BuscarFilaTextoExacto( _
                    ws, _
                    columna, _
                    seccionFinal, _
                    filaInicio + 1)

    If filaFin = 0 Then
        filaFin = ws.Cells( _
                    ws.Rows.Count, _
                    columna).End(xlUp).Row + 1
    End If

    BuscarFilaEntreSecciones = BuscarFilaTextoExacto( _
                                    ws, _
                                    columna, _
                                    textoBuscado, _
                                    filaInicio + 1, _
                                    filaFin - 1)

End Function

Private Function DetectarFilaMeses( _
    ByVal ws As Worksheet, _
    ByVal filaInicial As Long, _
    ByVal filaFinal As Long) As Long

    Dim fila As Long
    Dim columnaInicio As Long
    Dim columnaFin As Long
    Dim cantidad As Long
    Dim mayorCantidad As Long

    If filaInicial < 1 Then filaInicial = 1

    If filaFinal > ws.Rows.Count Then
        filaFinal = ws.Rows.Count
    End If

    For fila = filaInicial To filaFinal

        ObtenerBloqueMensualMasLargo _
            ws, _
            fila, _
            columnaInicio, _
            columnaFin

        If columnaInicio > 0 And columnaFin >= columnaInicio Then
            cantidad = columnaFin - columnaInicio + 1
        Else
            cantidad = 0
        End If

        If cantidad > mayorCantidad Then

            mayorCantidad = cantidad
            DetectarFilaMeses = fila

        End If

    Next fila

    If mayorCantidad < 3 Then
        DetectarFilaMeses = 0
    End If

End Function

Private Function PrimeraColumnaFecha( _
    ByVal ws As Worksheet, _
    ByVal fila As Long) As Long

    Dim columnaInicio As Long
    Dim columnaFin As Long

    ObtenerBloqueMensualMasLargo _
        ws, _
        fila, _
        columnaInicio, _
        columnaFin

    PrimeraColumnaFecha = columnaInicio

End Function

Private Function UltimaColumnaFecha( _
    ByVal ws As Worksheet, _
    ByVal fila As Long) As Long

    Dim columnaInicio As Long
    Dim columnaFin As Long

    ObtenerBloqueMensualMasLargo _
        ws, _
        fila, _
        columnaInicio, _
        columnaFin

    UltimaColumnaFecha = columnaFin

End Function

Private Sub ObtenerBloqueMensualMasLargo( _
    ByVal ws As Worksheet, _
    ByVal fila As Long, _
    ByRef mejorInicio As Long, _
    ByRef mejorFin As Long)

    Dim columna As Long
    Dim ultimaColumna As Long
    Dim inicioActual As Long
    Dim finActual As Long
    Dim mejorLongitud As Long
    Dim longitudActual As Long
    Dim fechaAnterior As Date
    Dim fechaActual As Date
    Dim tieneFechaAnterior As Boolean

    mejorInicio = 0
    mejorFin = 0
    mejorLongitud = 0
    inicioActual = 0
    finActual = 0
    tieneFechaAnterior = False

    ultimaColumna = ws.Cells( _
                        fila, _
                        ws.Columns.Count).End(xlToLeft).Column

    For columna = 1 To ultimaColumna

        If EsFechaProyecto(ws.Cells(fila, columna).Value) Then

            fechaActual = NormalizarMes( _
                            ws.Cells(fila, columna).Value)

            If tieneFechaAnterior _
               And columna = finActual + 1 _
               And DateDiff("m", fechaAnterior, fechaActual) = 1 Then

                finActual = columna

            Else

                inicioActual = columna
                finActual = columna

            End If

            longitudActual = finActual - inicioActual + 1

            If longitudActual > mejorLongitud Then

                mejorLongitud = longitudActual
                mejorInicio = inicioActual
                mejorFin = finActual

            End If

            fechaAnterior = fechaActual
            tieneFechaAnterior = True

        Else

            inicioActual = 0
            finActual = 0
            tieneFechaAnterior = False

        End If

    Next columna

End Sub

Private Function PrimeraFilaFecha( _
    ByVal ws As Worksheet, _
    ByVal columna As Long, _
    ByVal filaInicial As Long) As Long

    Dim fila As Long
    Dim ultimaFila As Long

    ultimaFila = ws.Cells( _
                    ws.Rows.Count, _
                    columna).End(xlUp).Row

    For fila = filaInicial To ultimaFila

        If EsFechaProyecto( _
                ws.Cells(fila, columna).Value) Then

            PrimeraFilaFecha = fila
            Exit Function

        End If

    Next fila

    PrimeraFilaFecha = 0

End Function

Private Function UltimaFilaMensualConsecutiva( _
    ByVal ws As Worksheet, _
    ByVal columna As Long, _
    ByVal filaInicial As Long) As Long

    Dim fila As Long
    Dim fechaAnterior As Date
    Dim fechaActual As Date

    If Not EsFechaProyecto( _
            ws.Cells(filaInicial, columna).Value) Then

        UltimaFilaMensualConsecutiva = 0
        Exit Function

    End If

    fechaAnterior = NormalizarMes( _
                        ws.Cells( _
                            filaInicial, _
                            columna).Value)

    UltimaFilaMensualConsecutiva = filaInicial

    For fila = filaInicial + 1 To ws.Rows.Count

        If Not EsFechaProyecto( _
                ws.Cells(fila, columna).Value) Then

            Exit For

        End If

        fechaActual = NormalizarMes( _
                            ws.Cells( _
                                fila, _
                                columna).Value)

        If DateDiff("m", fechaAnterior, fechaActual) <> 1 Then
            Exit For
        End If

        UltimaFilaMensualConsecutiva = fila
        fechaAnterior = fechaActual

    Next fila

End Function

Private Function BuscarColumnaTextoExacto( _
    ByVal ws As Worksheet, _
    ByVal fila As Long, _
    ByVal textoBuscado As String) As Long

    Dim columna As Long
    Dim ultimaColumna As Long
    Dim buscado As String

    buscado = NormalizarTexto(textoBuscado)

    ultimaColumna = ws.Cells( _
                        fila, _
                        ws.Columns.Count).End(xlToLeft).Column

    For columna = 1 To ultimaColumna

        If NormalizarTexto( _
                CStr(ws.Cells(fila, columna).Value)) = buscado Then

            BuscarColumnaTextoExacto = columna
            Exit Function

        End If

    Next columna

    BuscarColumnaTextoExacto = 0

End Function

Private Function EsFechaProyecto( _
    ByVal valor As Variant) As Boolean

    Dim fecha As Date

    If IsError(valor) Or IsEmpty(valor) Then Exit Function
    If Not IsDate(valor) Then Exit Function

    fecha = CDate(valor)

    If Year(fecha) < 2015 Or Year(fecha) > 2100 Then
        Exit Function
    End If

    EsFechaProyecto = True

End Function

Private Function NormalizarTexto( _
    ByVal texto As String) As String

    Dim resultado As String

    resultado = UCase$(Trim$(texto))
    resultado = Replace(resultado, Chr$(160), " ")
    resultado = Replace(resultado, vbCr, " ")
    resultado = Replace(resultado, vbLf, " ")

    resultado = Replace(resultado, "Á", "A")
    resultado = Replace(resultado, "É", "E")
    resultado = Replace(resultado, "Í", "I")
    resultado = Replace(resultado, "Ó", "O")
    resultado = Replace(resultado, "Ú", "U")
    resultado = Replace(resultado, "Ü", "U")

    Do While InStr(resultado, "  ") > 0
        resultado = Replace(resultado, "  ", " ")
    Loop

    NormalizarTexto = resultado

End Function

Private Function CalcularTIRAnual(ByVal rangoFlujos As Range) As Variant

    Dim tirMensual As Double

    On Error GoTo SinTIR

    tirMensual = Application.WorksheetFunction.IRR(rangoFlujos, 0.02)
    CalcularTIRAnual = (1 + tirMensual) ^ 12 - 1
    Exit Function

SinTIR:
    Err.Clear
    CalcularTIRAnual = Empty

End Function

Private Function NormalizarMes(ByVal valor As Variant) As Date

    If Not IsDate(valor) Then
        Err.Raise vbObjectError + 1050, "NormalizarMes", _
                  "El valor recibido no es una fecha válida."
    End If

    NormalizarMes = DateSerial(Year(CDate(valor)), Month(CDate(valor)), 1)

End Function

Private Function NumeroSeguro(ByVal valor As Variant) As Double

    If IsError(valor) Then
        NumeroSeguro = 0
        Exit Function
    End If

    If IsNull(valor) Or IsEmpty(valor) Then
        NumeroSeguro = 0
        Exit Function
    End If

    If Len(Trim$(CStr(valor))) = 0 Then
        NumeroSeguro = 0
    ElseIf IsNumeric(valor) Then
        NumeroSeguro = CDbl(valor)
    Else
        NumeroSeguro = 0
    End If

End Function

Private Function LetraColumna(ByVal numeroColumna As Long) As String

    Dim resultado As String
    Dim residuo As Long

    Do While numeroColumna > 0
        residuo = (numeroColumna - 1) Mod 26
        resultado = Chr$(65 + residuo) & resultado
        numeroColumna = (numeroColumna - residuo - 1) \ 26
    Loop

    LetraColumna = resultado

End Function


