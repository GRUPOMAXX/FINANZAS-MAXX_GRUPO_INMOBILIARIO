Private Function ValorPorEtiqueta( _
    ByVal ws As Worksheet, _
    ByVal columnaEtiqueta As Long, _
    ByVal columnaValor As Long, _
    ByVal etiqueta As String, _
    Optional ByVal filaInicial As Long = 1, _
    Optional ByVal filaFinal As Long = 0) As Double

    Dim celdaEtiqueta As Range
    Dim celdaValor As Range

    'Primero se intenta la ubicación recibida para mantener
    'compatibilidad con las plantillas anteriores.
    If columnaEtiqueta > 0 Then

        Set celdaEtiqueta = BuscarCeldaTextoExactoEnColumna( _
                                ws, _
                                columnaEtiqueta, _
                                etiqueta, _
                                filaInicial, _
                                filaFinal)

    End If

    'Si no está allí, se busca en todas las columnas utilizadas.
    If celdaEtiqueta Is Nothing Then

        Set celdaEtiqueta = BuscarCeldaTextoExacto( _
                                ws, _
                                etiqueta, _
                                filaInicial, _
                                filaFinal)

    End If

    If celdaEtiqueta Is Nothing Then

        Err.Raise vbObjectError + 1090, "ValorPorEtiqueta", _
                  "No se encontró '" & etiqueta & "' en la hoja '" & _
                  ws.Name & "'."

    End If

    'El valor se encuentra inmediatamente a la derecha del concepto.
    'Ejemplo:
    'Palace: concepto en C y valor en D.
    'Venecia: concepto en D y valor en E.
    Set celdaValor = celdaEtiqueta.Offset(0, 1)

    If IsError(celdaValor.Value) Then

        Err.Raise vbObjectError + 1091, "ValorPorEtiqueta", _
                  "El valor ubicado en " & _
                  celdaValor.Address(False, False) & _
                  ", junto a '" & etiqueta & "', contiene un error."

    End If

    ValorPorEtiqueta = NumeroSeguro(celdaValor.Value)

End Function

Private Function BuscarCeldaTextoExacto( _
    ByVal ws As Worksheet, _
    ByVal textoBuscado As String, _
    Optional ByVal filaInicial As Long = 1, _
    Optional ByVal filaFinal As Long = 0) As Range

    Dim fila As Long
    Dim columna As Long
    Dim ultimaFila As Long
    Dim primeraColumna As Long
    Dim ultimaColumna As Long
    Dim buscado As String

    If filaInicial < 1 Then filaInicial = 1

    ultimaFila = ws.UsedRange.Row + ws.UsedRange.Rows.Count - 1
    primeraColumna = ws.UsedRange.Column
    ultimaColumna = ws.UsedRange.Column + ws.UsedRange.Columns.Count - 1

    If filaFinal <= 0 Or filaFinal > ultimaFila Then
        filaFinal = ultimaFila
    End If

    buscado = NormalizarTexto(textoBuscado)

    For fila = filaInicial To filaFinal

        For columna = primeraColumna To ultimaColumna

            If NormalizarTexto( _
                    CStr(ws.Cells(fila, columna).Value)) = buscado Then

                Set BuscarCeldaTextoExacto = _
                    ws.Cells(fila, columna)

                Exit Function

            End If

        Next columna

    Next fila

    Set BuscarCeldaTextoExacto = Nothing

End Function

Private Function BuscarCeldaTextoExactoEnColumna( _
    ByVal ws As Worksheet, _
    ByVal columna As Long, _
    ByVal textoBuscado As String, _
    Optional ByVal filaInicial As Long = 1, _
    Optional ByVal filaFinal As Long = 0) As Range

    Dim fila As Long
    Dim ultimaFila As Long
    Dim buscado As String

    If filaInicial < 1 Then filaInicial = 1

    ultimaFila = ws.Cells( _
                    ws.Rows.Count, _
                    columna).End(xlUp).Row

    If filaFinal <= 0 Or filaFinal > ultimaFila Then
        filaFinal = ultimaFila
    End If

    buscado = NormalizarTexto(textoBuscado)

    For fila = filaInicial To filaFinal

        If NormalizarTexto( _
                CStr(ws.Cells(fila, columna).Value)) = buscado Then

            Set BuscarCeldaTextoExactoEnColumna = _
                ws.Cells(fila, columna)

            Exit Function

        End If

    Next fila

    Set BuscarCeldaTextoExactoEnColumna = Nothing

End Function

