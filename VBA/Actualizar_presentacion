Private Function BuscarValorVertical( _
    ByVal clave As Variant, _
    ByVal rangoClaves As Range, _
    ByVal rangoValores As Range, _
    ByVal descripcion As String) As Variant

    Dim posicion As Variant

    posicion = Application.Match(clave, rangoClaves, 0)

    If IsError(posicion) Then
        Err.Raise vbObjectError + 1040, "BuscarValorVertical", _
                  "No se encontró '" & CStr(clave) & "' en " & descripcion & "."
    End If

    If IsError(rangoValores.Cells(CLng(posicion), 1).Value) Then
        Err.Raise vbObjectError + 1042, "BuscarValorVertical", _
                  "La celda de resultado para '" & CStr(clave) & _
                  "' contiene un error en " & descripcion & "."
    End If

    BuscarValorVertical = rangoValores.Cells(CLng(posicion), 1).Value

End Function

